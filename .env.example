# Все переменные — серверные (без NEXT_PUBLIC_), в браузер не попадают.
# Локально копируйте в .env.local, в проде задайте в Vercel → Settings → Environment Variables.

# Адрес бэкенда (без /api на конце)
BACKEND_URL=https://inst-parser.emu.web-perfomance.uz

# Bearer-токен бэкенда. Должен совпадать с API_TOKEN в .env на сервере.
BACKEND_API_TOKEN=

# Ключ подписи сессий, >= 32 символов:  openssl rand -base64 48
SESSION_SECRET=

# Логин и хэш пароля. Хэш:  npm run hash-password -- 'ваш-пароль-от-12-символов'
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
